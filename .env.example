# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - FRATRES BARBEARIA
# Apenas a URL do Supabase e a chave pública (ANON KEY) devem estar no front-end.
# NUNCA insira a SUPABASE_SERVICE_ROLE_KEY neste arquivo ou no código cliente!
# ==============================================================================

# Supabase Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Compatibilidade Next.js / Vite
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile (Chave do Site - Pública)
# Obtenha em: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
